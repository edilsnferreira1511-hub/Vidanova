{
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "functions": [{
    "source": ".",
    "codebase": "default",
    "runtime": "nodejs20",
    "ignore": ["node_modules", ".git", "*.html", "*.css", "*.jpg", "*.md", "*.rules", "app.js", "admin.js", "firebase-config.js", "firebase-init.js", "firebase.json", ".firebaserc"]
  }],
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "index.js", "package.json", "package-lock.json", "*.rules", "README.md"],
    "headers": [
      { "source": "**/*.@(jpg|png|webp)", "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }] }
    ]
  }
}
