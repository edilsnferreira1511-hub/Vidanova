rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Catálogo: qualquer pessoa vê; só admin altera.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: criados SOMENTE pela Cloud Function (preço verificado no servidor).
    // Cliente lê só os próprios; admin lê todos e muda status/rastreio.
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'tracking', 'updatedAt']);
      allow create, delete: if false;
    }

    // Dados de entrega salvos do cliente.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Lista de administradores: só se cria pelo Console do Firebase.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
