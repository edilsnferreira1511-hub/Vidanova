// =====================================================================================
// PROPOSTA — NÃO APLICADA E NÃO TESTADA (sem emulador do Firestore neste ambiente).
// NÃO substitui as regras do XPT: deve ser MESCLADA a elas, só ACRESCENTANDO o bloco abaixo,
// sem alterar nenhuma regra existente (inclusive as de `backups`, `claims`, `users`, etc.).
// Antes de publicar: colar no editor de regras, testar no "Simulador de regras" do Console e revisar.
// Caminhos e campos vieram do cadastro informado: env/producao/users/{uid} com
// role (texto), xptIds (lista), active (booleano).
// =====================================================================================
//
// Coloque dentro de:  match /databases/{database}/documents { match /env/producao { ... } }
// (se as regras do XPT já tiverem esse aninhamento, acrescente só as funções bk* e o match abaixo)

function bkUser() {
  return get(/databases/$(database)/documents/env/producao/users/$(request.auth.uid)).data;
}
function bkAtivo() {
  return request.auth != null
    && exists(/databases/$(database)/documents/env/producao/users/$(request.auth.uid))
    && bkUser().active == true;
}
function bkRole() { return bkUser().role; }
// Pelo cadastro do XPT, estes cargos enxergam todas as bases.
function bkTodasBases() { return bkAtivo() && bkRole() in ['admin_sistema', 'administrador', 'coord_geral']; }
function bkPodeBase(base) { return bkTodasBases() || (bkAtivo() && base in bkUser().xptIds); }

// Coleção PRÓPRIA do sistema de backup (não é a subcoleção `backups` que já existe).
match /backup_requests/{reqId} {

  // Leitura: cargo com acesso ao sistema E base autorizada. Filtro visual não protege dados; isto sim.
  // O app consulta uma base por vez (where base == X), que é o formato que estas regras conseguem validar.
  allow read: if bkAtivo()
              && bkRole() in ['despacho', 'supervisor', 'coord_geral']
              && bkPodeBase(resource.data.base);

  // Criação: despacho, na própria base, como solicitante, sempre PENDENTE e sem decisão.
  allow create: if bkAtivo()
                && bkRole() == 'despacho'
                && bkPodeBase(request.resource.data.base)
                && request.resource.data.solicitante.uid == request.auth.uid
                && request.resource.data.status == 'PENDENTE'
                && !('decisao' in request.resource.data)
                && request.resource.data.historico.size() == 1
                && request.resource.data.historico[0].status == 'PENDENTE'
                && request.resource.data.historico[0].porUid == request.auth.uid;

  // Atualização: só status/historico/decisao; o histórico só cresce, com UMA entrada nova por mudança.
  allow update: if bkAtivo()
                && bkPodeBase(resource.data.base)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'historico', 'decisao'])
                && request.resource.data.historico.size() == resource.data.historico.size() + 1
                && request.resource.data.historico[0:resource.data.historico.size()] == resource.data.historico
                && request.resource.data.historico[resource.data.historico.size()].status == request.resource.data.status
                && request.resource.data.historico[resource.data.historico.size()].porUid == request.auth.uid
                && (
                  // Cancelar: o próprio solicitante, enquanto PENDENTE
                  ( resource.data.status == 'PENDENTE'
                    && request.resource.data.status == 'CANCELADO'
                    && resource.data.solicitante.uid == request.auth.uid
                    && !('decisao' in request.resource.data.diff(resource.data).affectedKeys()) )
                  ||
                  // Colocar em análise: supervisor ou coordenador geral (REGRA A CONFIRMAR)
                  ( bkRole() in ['supervisor', 'coord_geral']
                    && resource.data.status == 'PENDENTE'
                    && request.resource.data.status == 'EM_ANALISE'
                    && !('decisao' in request.resource.data.diff(resource.data).affectedKeys()) )
                  ||
                  // Decidir: só coordenador geral, nunca o próprio pedido
                  ( bkRole() == 'coord_geral'
                    && resource.data.solicitante.uid != request.auth.uid
                    && resource.data.status in ['PENDENTE', 'EM_ANALISE']
                    && request.resource.data.status in ['APROVADO', 'RECUSADO']
                    && request.resource.data.decisao.resultado == request.resource.data.status
                    && request.resource.data.decisao.porUid == request.auth.uid
                    && request.resource.data.decisao.justificativa is string
                    && request.resource.data.decisao.justificativa.size() > 0
                    && request.resource.data.decisao.descontoCooperado in ['SIM', 'NAO'] )
                );

  // Nada é apagado: o histórico das decisões é preservado.
  allow delete: if false;
}

// Para o app mostrar o NOME das bases, o usuário ativo precisa ler env/producao/xpts (se as regras atuais
// já permitirem, nada a fazer; se não, o app funciona mostrando só o id da base).
//
// Pontos em aberto:
// - `coord_base` está FORA destas regras até haver decisão (PENDENCIAS.md).
// - Se o XPT já tiver regras que casem `env/producao/{qualquer}/{doc}`, confirmar que não liberam esta coleção
//   a mais gente do que o desejado.
// - Horário oficial: se for exigido, validar `criadoEmServidor == request.time` na criação.
